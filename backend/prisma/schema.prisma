generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String         @id @default(uuid())
  name          String         @db.VarChar(50)
  email         String         @unique
  password      String
  budgetLimit   Float          @default(0)
  currency      String         @default("INR")
  tokenVersion  Int            @default(0)
  expenses      Expense[]
  budgets       Budget[]
  notifications Notification[]
  emis          EMI[]
  assets        Asset[]
  liabilities   Liability[]
  pushSubscriptions PushSubscription[]
  fcmTokens     FcmToken[]
  ledgerContacts LedgerContact[]
  ledgerEntries  LedgerEntry[]
  passwordResetTokens PasswordResetToken[]
  loginEvents   LoginEvent[]
  incomeSources   IncomeSource[]
  monthlySalaries MonthlySalary[]
  budgetPlans     BudgetPlan[]
  savingsGoals    SavingsGoal[]
  investmentPlans InvestmentPlan[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model LoginEvent {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

model LedgerContact {
  id        String        @id @default(uuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String        @db.VarChar(50)
  phone     String?       @db.VarChar(20)
  note      String?       @db.VarChar(300)
  entries   LedgerEntry[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([userId])
}

model LedgerEntry {
  id          String        @id @default(uuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  contactId   String
  contact     LedgerContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  type        String        // LENT | BORROWED | REPAYMENT_RECEIVED | REPAYMENT_MADE
  amount      Float
  date        DateTime      @default(now())
  note        String?       @db.VarChar(500)
  settled     Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([userId, contactId])
  @@index([userId, date])
}

model Expense {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String    @db.VarChar(100)
  amount         Float
  category       String
  type           String    @default("expense")
  accountType    String    @default("Cash")
  fromAccountType String?
  toAccountType   String?
  paymentMethod  String    @default("UPI")
  note           String?   @db.VarChar(500)
  expenseDate    DateTime  @default(now())
  recurring      Boolean   @default(false)
  recurringType  String?
  nextRunDate    DateTime?
  isAutoCreated  Boolean   @default(false)
  monthlySalary         MonthlySalary?
  allocationAssignment  AllocationAssignment?
  investmentTransaction InvestmentTransaction?
  emiPayment            EMIPayment?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId, expenseDate])
  @@index([userId, category])
  @@index([userId, accountType])
  @@index([recurring, nextRunDate])
}

model Budget {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     String
  monthlyLimit Float
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, category])
}

model EMI {
  id                   String   @id @default(uuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title                String   @db.VarChar(100)
  totalAmount          Float
  emiAmount            Float?
  totalInstallments    Int?
  paidInstallments     Int      @default(0)
  paidAmount           Float    @default(0)
  startDate            DateTime
  nextDueDate          DateTime?
  note                 String?  @db.VarChar(500)
  active               Boolean  @default(true)
  type                 String   @default("FIXED")
  interestRate         Float?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  payments             EMIPayment[]

  @@index([userId, active])
}

model EMIPayment {
  id          String   @id @default(uuid())
  emiId       String
  emi         EMI      @relation(fields: [emiId], references: [id], onDelete: Cascade)
  amount      Float
  paidAt      DateTime @default(now())
  note        String?  @db.VarChar(500)
  // Set only when the user confirms this payment is the same money as a History expense, so that
  // expense is not counted a second time in the planner. Unique: one transaction backs one payment.
  expenseId   String?  @unique
  expense     Expense? @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([emiId])
}

model Asset {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String   @db.VarChar(100)
  type      String
  value     Float
  note      String?  @db.VarChar(500)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Liability {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String   @db.VarChar(100)
  type      String
  value     Float
  note      String?  @db.VarChar(500)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  String
  percentage Float    @default(0)
  message   String
  type      String   @default("warning")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  installedApp Boolean @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model FcmToken {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String    @unique
  device     String?   @db.VarChar(100)
  platform   String?   @db.VarChar(50)
  installedApp Boolean @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  lastUsedAt DateTime?

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Salary & Monthly Financial Planner
// Money is Decimal(14,2) here (unlike the legacy Float columns) and is computed in paise.
// Planned figures live only in these tables; actual money movement is always an Expense row,
// so nothing here changes account balances on its own.
// ---------------------------------------------------------------------------

model IncomeSource {
  id             String          @id @default(uuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String          @db.VarChar(50)
  kind           String          @default("SALARY") // SALARY | ALLOWANCE | BONUS | INCENTIVE | OTHER
  expectedAmount Decimal         @db.Decimal(14, 2)
  payDay         Int? // 1-31; clamped to the month's last day when used
  active         Boolean         @default(true)
  monthlyRecords MonthlySalary[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([userId, active])
}

model MonthlySalary {
  id             String        @id @default(uuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Null for one-off income, or when the source was deleted; label/kind keep the history readable.
  incomeSourceId String?
  incomeSource   IncomeSource? @relation(fields: [incomeSourceId], references: [id], onDelete: SetNull)
  label          String        @db.VarChar(50)
  kind           String        @default("SALARY")
  year           Int
  month          Int // 1-12
  expectedAmount Decimal       @db.Decimal(14, 2)
  receivedAmount Decimal       @default(0) @db.Decimal(14, 2)
  receivedAt     DateTime?
  // "Already in my balance": received with no transaction behind it, so nothing is added to History.
  countedInBalance Boolean     @default(false)
  // The income transaction that records the money arriving; unique so one transaction backs one record.
  expenseId      String?       @unique
  expense        Expense?      @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([incomeSourceId, year, month])
  @@index([userId, year, month])
}

model BudgetPlan {
  id          String             @id @default(uuid())
  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  year        Int
  month       Int // 1-12
  note        String?            @db.VarChar(500)
  savingsPercent Int             @default(20)
  allocations BudgetAllocation[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([userId, year, month])
}

model BudgetAllocation {
  id               String                 @id @default(uuid())
  planId           String
  plan             BudgetPlan             @relation(fields: [planId], references: [id], onDelete: Cascade)
  group            String // FIXED | VARIABLE | SAVINGS | INVESTMENT
  name             String                 @db.VarChar(50)
  plannedAmount    Decimal                @db.Decimal(14, 2)
  // Expense categories counted against this line when a transaction has no explicit assignment.
  matchCategories  String[]               @default([])
  recurring        Boolean                @default(true)
  sortOrder        Int                    @default(0)
  savingsGoalId    String?
  savingsGoal      SavingsGoal?           @relation(fields: [savingsGoalId], references: [id], onDelete: SetNull)
  investmentPlanId String?
  investmentPlan   InvestmentPlan?        @relation(fields: [investmentPlanId], references: [id], onDelete: SetNull)
  assignments      AllocationAssignment[]
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@unique([planId, name])
  @@index([savingsGoalId])
  @@index([investmentPlanId])
}

// Pins one transaction to one allocation; expenseId is unique so a transaction is never counted twice.
model AllocationAssignment {
  id           String           @id @default(uuid())
  expenseId    String           @unique
  expense      Expense          @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  allocationId String
  allocation   BudgetAllocation @relation(fields: [allocationId], references: [id], onDelete: Cascade)
  createdAt    DateTime         @default(now())

  @@index([allocationId])
}

model SavingsGoal {
  id                  String                @id @default(uuid())
  userId              String
  user                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                String                @db.VarChar(50)
  targetAmount        Decimal               @db.Decimal(14, 2)
  // Already saved before the goal was created; current saved = initial + contributions - withdrawals.
  initialAmount       Decimal               @default(0) @db.Decimal(14, 2)
  monthlyContribution Decimal?              @db.Decimal(14, 2)
  targetDate          DateTime?
  archived            Boolean               @default(false)
  note                String?               @db.VarChar(500)
  contributions       SavingsContribution[]
  allocations         BudgetAllocation[]
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@index([userId, archived])
}

// Earmarks money that stays in the user's accounts, so it never creates or links a transaction.
model SavingsContribution {
  id        String      @id @default(uuid())
  goalId    String
  goal      SavingsGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  type      String      @default("CONTRIBUTION") // CONTRIBUTION | WITHDRAWAL
  amount    Decimal     @db.Decimal(14, 2)
  date      DateTime
  note      String?     @db.VarChar(300)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([goalId, date])
}

model InvestmentPlan {
  id                   String                  @id @default(uuid())
  userId               String
  user                 User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                 String                  @db.VarChar(50)
  category             String // GOLD | GOLD_ETF | MUTUAL_FUND | INDEX_FUND | STOCK | OTHER
  monthlyPlannedAmount Decimal                 @default(0) @db.Decimal(14, 2)
  active               Boolean                 @default(true)
  note                 String?                 @db.VarChar(500)
  transactions         InvestmentTransaction[]
  allocations          BudgetAllocation[]
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  @@index([userId, active])
}

model InvestmentTransaction {
  id        String         @id @default(uuid())
  planId    String
  plan      InvestmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  type      String         @default("BUY") // BUY | REDEEM
  amount    Decimal        @db.Decimal(14, 2)
  date      DateTime
  note      String?        @db.VarChar(300)
  // The Investment-category transaction that moved the money. Cascade: deleting it in History
  // undoes the investment too, so the two can never disagree.
  expenseId String?        @unique
  expense   Expense?       @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([planId, date])
}
